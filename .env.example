# Web
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_DEMO_TOKEN=demo-masha-token

# API
HTTP_ADDR=:8080
DEMO_TOKEN=demo-masha-token
DEMO_OFFLINE=1
USE_MEMORY_STORE=1
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./data/uploads
LOG_LEVEL=info

# Optional cloud LLM (when DEMO_OFFLINE=0)
# RU VPS note: OpenAI/Groq/OpenRouter are often geo-blocked.
# Working free option from the VPS: Pollinations (OpenAI-compatible, no real key).
# LLM_BASE_URL=https://text.pollinations.ai/openai
# LLM_API_KEY=pollinations
# LLM_MODEL=openai-fast
# More stable paid/free-tier options reachable from RU VPS: DeepSeek, Mistral, ProxyAPI.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional full stack
DATABASE_URL=postgres://copilot:copilot@localhost:5432/copilot?sslmode=disable
REDIS_URL=redis://localhost:6379/0
