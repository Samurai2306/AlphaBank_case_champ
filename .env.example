# Web
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_DEMO_TOKEN=demo-masha-token

# API
HTTP_ADDR=:8080
DEMO_TOKEN=demo-masha-token
DEMO_OFFLINE=1
USE_MEMORY_STORE=1
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./data/uploads
LOG_LEVEL=info

# Optional cloud LLM (when DEMO_OFFLINE=0)
# RU VPS defaults: OpenCode Zen free tier (works without paid key).
# Failover rotates LLM_MODELS, then optional LLM_FALLBACK_*.
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_API_KEY=public
LLM_PROVIDER=opencode-zen
LLM_MODEL=deepseek-v4-flash-free
LLM_MODELS=deepseek-v4-flash-free,qwen3.6-plus-free,minimax-m2.5-free
# Optional paid backup (DeepSeek platform key) — keeps chat alive if Zen rate-limits:
# LLM_FALLBACK_BASE_URL=https://api.deepseek.com
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=deepseek-chat
# LLM_FALLBACK_PROVIDER=openai

# Optional full stack
DATABASE_URL=postgres://copilot:copilot@localhost:5432/copilot?sslmode=disable
REDIS_URL=redis://localhost:6379/0
